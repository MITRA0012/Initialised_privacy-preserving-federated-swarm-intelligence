{
  "name": "kin-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first personal AI agent for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "desktop:dev": "set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.kin.agent",
    "productName": "Kin Agent",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "protocols": [{ "name": "Kin Agent", "schemes": ["kin-agent"] }],
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
